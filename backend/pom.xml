<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>za.co.ntsumele</groupId>
  <artifactId>ntsumele-bank</artifactId>
  <version>1.0.0</version>
  <name>Ntsumele Bank</name>
  <description>Customer transaction access and dispute case management</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}/../frontend/dist/ntsumele-bank/browser</directory>
        <targetPath>static</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>za.co.ntsumele.bank.NtsumeleBankApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>postgres-integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <failIfNoTests>true</failIfNoTests>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>postgres-tls</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes><include>**/PostgresTlsVerification.java</include></includes>
              <failIfNoTests>true</failIfNoTests>
            </configuration>
            <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>security</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>13.0.0</version>
            <configuration>
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <failOnError>true</failOnError>
              <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
              <formats><format>HTML</format><format>JSON</format><format>SARIF</format></formats>
              <skipTestScope>false</skipTestScope>
              <failBuildOnUnusedSuppressionRule>true</failBuildOnUnusedSuppressionRule>
            </configuration>
            <executions><execution><goals><goal>check</goal></goals></execution></executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>sbom</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>2.9.3</version>
            <configuration>
              <schemaVersion>1.6</schemaVersion>
              <outputFormat>json</outputFormat>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <outputName>bom</outputName>
              <includeTestScope>false</includeTestScope>
              <includeLicenseText>true</includeLicenseText>
            </configuration>
            <executions>
              <execution>
                <id>default</id>
                <phase>package</phase>
                <goals><goal>makeAggregateBom</goal></goals>
                <configuration combine.self="override">
                  <projectType>application</projectType>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                  <outputName>bom</outputName>
                  <outputFormat>json</outputFormat>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
