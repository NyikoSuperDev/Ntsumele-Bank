{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "npm",
    "maven",
    "dockerfile",
    "docker-compose",
    "github-actions"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "schedule": [
    "before 5am on monday"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor"
      ],
      "groupName": "reviewed non-major dependency updates"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  }
}
