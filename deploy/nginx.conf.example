# Host-installed Nginx example. Replace the public hostname/certificate paths.
# The application port stays on loopback; firewall it against every other peer.
server {
    listen 80;
    server_name bank.example.invalid;
    return 308 https://bank.example.invalid$request_uri;
}
server {
    listen 443 ssl;
    server_name bank.example.invalid;
    ssl_certificate /etc/ntsumele/tls/server.crt;
    ssl_certificate_key /etc/ntsumele/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 32k;
    location / {
        proxy_hide_header Strict-Transport-Security;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host bank.example.invalid;
        proxy_set_header X-Forwarded-Host bank.example.invalid;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
